# ==============================================================================
# FlowPilot Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development.
# NOTE: Never commit secret credentials or real API keys to version control.

# Base URL for Next.js app and browser runner navigation
# Default: http://localhost:3000
FLOWPILOT_BASE_URL=http://localhost:3000

# Temporal reference date for consistent ground-truth evaluation and date filtering.
# Format: YYYY-MM-DD
# Default in codebase: 2026-10-25 (matching demo portal assignment timeline)
FLOWPILOT_REFERENCE_DATE=2026-10-25

# Optional: Google Gemini API Key for model-backed task planning
# Obtain a free-tier key from Google AI Studio: https://aistudio.google.com/
# If unset or invalid, FlowPilot automatically uses the deterministic fallback planner
# with 100% test suite and ground-truth parity.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Remote Browser Worker Endpoint
# For deployments on serverless platforms (e.g., Vercel) where local Chromium binaries
# exceed function bundle size limits. FlowPilot will delegate Playwright actions to this URL.
# Example: https://flowpilot-worker.onrender.com
FLOWPILOT_WORKER_URL=

# Optional: Server-Side Shared Secret for Remote Browser Worker Authentication
# Used in the Authorization header (Bearer token) and X-FlowPilot-Secret when
# communicating with the dedicated worker container.
# Server-side only: never exposed in client code.
FLOWPILOT_WORKER_SECRET=your_worker_shared_secret_here
